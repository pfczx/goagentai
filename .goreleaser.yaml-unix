project_name: goagentai

builds:
  - binary: goagentai
    main: ./main.go
    goos:
      - linux
      - darwin
    goarch:
      - "386"
      - "amd64"
      - "arm64"
    ldflags:
      - -s -w
    env:
      CGO_ENABLED: "1"

archives:
  - format: tar.gz

checksum:
  name_template: "checksums.txt"
