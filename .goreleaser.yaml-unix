project_name: goagentai

builds:
  - binary: goagentai
    main: ./main.go
    goos:
      - linux
      - darwin
    goarch:
      - "386"
      - "amd64"
      - "arm64"
    ldflags:
      - -s -w

archives:
  - format: zip
    files:
      - LICENSE
      - README.md

checksum:
  name_template: "checksums.txt"
